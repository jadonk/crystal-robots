/* puts 38+2*2 
 * puts 19 */
digraph {
  node [shape=plaintext, fontcolor=red, fontsize=18];
  "5:" -> "4:" -> "3:" -> "2:" -> "1:" -> "0:" [color=white];
  node [shape=record, fontcolor=black, fontsize=14, width=4.75, fixedsize=true];

  pass5 [label="<l0> ⏹", color=white];
  pass4 [label="<l0> ❤ | <l6> ❤", color=white];
  pass3 [label="<l0> ∊ | <l1> 😑 | <l6> ❤", color=white];
  pass2 [label="<l0> ∊ | <l1> № | <l2> ⊕ | <l3> 😑 | <l6> ❤", color=white];
  pass1 [label="<l0> ∊ | <l1> № | <l2> ⊕ | <l3> № | <l4> ⊗ | <l5> № | <l6> ∊ | <l7> №", color=white];
  pass0 [label="<l0> puts | <l1> 38 | <l2> + | <l3> 2 | <l4> * | <l5> 2 | <l6> puts | <l7> 19", color=white];

  { rank=same; "5:"; pass5 }
  { rank=same; "4:"; pass4 }
  { rank=same; "3:"; pass3 }
  { rank=same; "2:"; pass2 }
  { rank=same; "1:"; pass1 }
  { rank=same; "0:"; pass0 }

  edge [color=blue]
    pass5:l0 -> pass4:l0;
    pass5:l0 -> pass4:l6;
    pass4:l0 -> pass3:l0;
    pass4:l0 -> pass3:l1;
    pass4:l6 -> pass3:l6;
    pass3:l0 -> pass2:l0;
    pass3:l1 -> pass2:l1;
    pass3:l1 -> pass2:l2;
    pass3:l1 -> pass2:l3;
    pass3:l6 -> pass2:l6;
    pass2:l0 -> pass1:l0;
    pass2:l1 -> pass1:l1;
    pass2:l2 -> pass1:l2;
    pass2:l3 -> pass1:l3;
    pass2:l3 -> pass1:l4;
    pass2:l3 -> pass1:l5;
    pass2:l6 -> pass1:l6;
    pass2:l6 -> pass1:l7;
    pass1:l0 -> pass0:l0;
    pass1:l1 -> pass0:l1;
    pass1:l2 -> pass0:l2;
    pass1:l3 -> pass0:l3;
    pass1:l4 -> pass0:l4;
    pass1:l5 -> pass0:l5;
    pass1:l6 -> pass0:l6;
    pass1:l7 -> pass0:l7;
}

