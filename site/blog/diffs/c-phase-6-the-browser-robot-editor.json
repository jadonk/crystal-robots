      "file": "spec/wasm32_spec.cr",
      "note": "The spec changes an example robot before asking the browser checker to read it. That proves the live check handles the reader’s own edits, not just bundled code.",
      "before": [
        {
          "kind": "+",
          "text": "  # Phase 6: `site/cheat-sheet.json` (`scripts/build_cheat_sheet.cr`, a",
          "old": null,
          "new": 111
        },
        {
          "kind": "+",
          "text": "  # `ci.cr --with-wasm32` step) is the file the editor's page fetches; it",
          "old": null,
          "new": 112
        },
        {
          "kind": "+",
          "text": "  # must be byte-identical to `RobotAPI.cheat_sheet_json` computed fresh",
          "old": null,
          "new": 113
        },
        {
          "kind": "+",
          "text": "  # right now, not just structurally similar -- otherwise a rebuild that",
          "old": null,
          "new": 114
        },
        {
          "kind": "+",
          "text": "  # changes `ENTRIES` without re-running the generator would ship a stale",
          "old": null,
          "new": 115
        },
        {
          "kind": "+",
          "text": "  # cheat-sheet next to the always-current served panel.",
          "old": null,
          "new": 116
        },
        {
          "kind": "+",
          "text": "  wasm32_it \"exports site/cheat-sheet.json identical to the panel's own data, right now\" do",
          "old": null,
          "new": 117
        },
        {
          "kind": "+",
          "text": "    File.read(\"site/cheat-sheet.json\").should eq CrystalRobots::Web::RobotAPI.cheat_sheet_json",
          "old": null,
          "new": 118
        },
        {
          "kind": "+",
          "text": "  end",
          "old": null,
          "new": 119
        },
        {
          "kind": "+",
          "text": "",
          "old": null,
          "new": 120
        },
        {
          "kind": "+",
          "text": "  # Phase 6: the editor forks an example, the kid edits it, and it must",
          "old": null,
          "new": 121
        },
        {
          "kind": "+",
          "text": "  # still check clean through the same non-raising path (`crd_check`,",
          "old": null,
          "new": 122
        }
      ],
      "lines": [
        {
          "kind": "+",
          "text": "  # `Browser.check`) the live-typing loop uses -- proof that an edited",
          "old": null,
          "new": 123
        },
        {
          "kind": "+",
          "text": "  # example round-trips through the module, not just an untouched one.",
          "old": null,
          "new": 124
        },
        {
          "kind": "+",
          "text": "  wasm32_it \"checks an edited example clean through crd_check, not just the untouched original\" do",
          "old": null,
          "new": 125
        },
        {
          "kind": "+",
          "text": "    original = File.read(\"examples/sniper.cr\")",
          "old": null,
          "new": 126
        },
        {
          "kind": "+",
          "text": "    edited = original.sub(\"main(\\\"Sniper\\\")\", \"main(\\\"Sniper Junior\\\")\") + \"# edited by the editor's live-check spec\\n\"",
          "old": null,
          "new": 127
        },
        {
          "kind": "+",
          "text": "    edited.should_not eq original",
          "old": null,
          "new": 128
        },
        {
          "kind": "+",
          "text": "",
          "old": null,
          "new": 129
        },
        {
          "kind": "+",
          "text": "    report = Browser32.check(edited)",
          "old": null,
          "new": 130
        }
      ],
      "after": [
        {
          "kind": "+",
          "text": "    report[\"trapped\"]?.should be_nil",
          "old": null,
          "new": 131
        },
        {
