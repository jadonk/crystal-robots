          "kind": " ",
          "text": "  return report;",
          "old": 174,
          "new": 192
        },
        {
          "kind": " ",
          "text": "}",
          "old": 175,
          "new": 193
        },
        {
          "kind": "+",
          "text": "",
          "old": null,
          "new": 194
