          "kind": "+",
          "text": "// same renderer the served `/battle` page uses -- or",
          "old": null,
          "new": 202
        },
        {
          "kind": "+",
          "text": "// `{ trapped: true, stderr }` if the request itself was malformed (a page",
          "old": null,
          "new": 203
        }
      ],
      "lines": [
        {
          "kind": "+",
          "text": "// bug, not a robot's: an individual robot's parse/check/runtime failure is",
          "old": null,
          "new": 204
        },
        {
          "kind": "+",
          "text": "// reported per-robot in `robots[].error` instead).",
          "old": null,
          "new": 205
        },
        {
          "kind": "+",
          "text": "export async function battle(compiledModule, robots, seed, limit, cps, { onStderr } = {}) {",
          "old": null,
          "new": 206
        },
        {
          "kind": "+",
          "text": "  const payload = JSON.stringify({ robots, seed, limit, cps });",
          "old": null,
          "new": 207
        },
        {
          "kind": "+",
          "text": "  const result = await callEntry(",
          "old": null,
          "new": 208
        },
        {
          "kind": "+",
          "text": "    compiledModule, payload, \"crd_battle_alloc\", \"crd_battle_run\", \"crd_battle_result_ptr\", \"crd_battle_result_len\", onStderr,",
          "old": null,
          "new": 209
        },
        {
          "kind": "+",
          "text": "  );",
          "old": null,
          "new": 210
        },
        {
          "kind": "+",
          "text": "  if (result.trapped) return result;",
          "old": null,
          "new": 211
        }
      ],
      "after": [
        {
          "kind": "+",
          "text": "  return result.report;",
          "old": null,
          "new": 212
        },
        {
          "kind": "+",
          "text": "}",
          "old": null,
          "new": 213
        }
      ],
      "line_notes": {}
    },
