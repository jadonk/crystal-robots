        {
          "kind": "+",
          "text": "// -- `svg` the whole match as one SMIL-animated SVG string",
          "old": null,
          "new": 200
        },
        {
          "kind": "+",
          "text": "// (`CrystalRobots::Battle.svg_animation`, `src/battle/svg_replay.cr`), the",
          "old": null,
          "new": 201
