        {
          "kind": "+",
          "text": "// Runs one match entirely in the module: `robots` is 2 to 4",
          "old": null,
          "new": 195
        },
        {
          "kind": "+",
          "text": "// `{ name, source }` pairs, `seed`/`limit` the same meaning as",
