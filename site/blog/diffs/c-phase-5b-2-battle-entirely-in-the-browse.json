    {
      "file": "src/battle/step_robot.cr",
      "note": "A robot spends one cycle and saves the rest of its work for its next turn. That lets the page alternate robots without depending on Crystal fibers or exceptions.",
      "before": [
        {
          "kind": "+",
          "text": "        if (a = int(args[0])) && (b = int(args[1]))",
          "old": null,
          "new": 711
        },
        {
          "kind": "+",
          "text": "          cont.call(host.drive(a, b))",
          "old": null,
          "new": 712
        },
        {
          "kind": "+",
          "text": "        end",
          "old": null,
          "new": 713
        },
        {
          "kind": "+",
          "text": "      else",
          "old": null,
          "new": 714
        },
        {
          "kind": "+",
          "text": "        runtime_error(\"unknown builtin #{name}\")",
          "old": null,
          "new": 715
        },
        {
          "kind": "+",
          "text": "      end",
          "old": null,
          "new": 716
        },
        {
          "kind": "+",
          "text": "    end",
          "old": null,
          "new": 717
        },
        {
          "kind": "+",
          "text": "",
          "old": null,
          "new": 718
        },
        {
          "kind": "+",
          "text": "    # Charges exactly one cycle and pauses -- unless `n <= 0`, nothing to",
          "old": null,
          "new": 719
        },
        {
          "kind": "+",
          "text": "    # charge, run straight through. The pause is `@resume`: a closure that",
          "old": null,
          "new": 720
        },
        {
          "kind": "+",
          "text": "    # re-enters here with `n - 1` and the same `after`, so a `tick(n)` call",
          "old": null,
          "new": 721
        },
        {
          "kind": "+",
          "text": "    # (a builtin costs 2, a call costs 3, and so on) still pauses once per",
          "old": null,
          "new": 722
        }
      ],
      "lines": [
        {
          "kind": "+",
          "text": "    # unit, matching `field.cr`'s fiber granularity (whose `on_step` hook",
          "old": null,
          "new": 723
        },
        {
          "kind": "+",
          "text": "    # likewise charges `@cycles` once per unit, not once per `tick` call).",
          "old": null,
          "new": 724
        },
        {
          "kind": "+",
          "text": "    private def tick(n : Int32, &after : -> Nil) : Nil",
          "old": null,
          "new": 725
        },
        {
          "kind": "+",
          "text": "      return if @halted",
          "old": null,
          "new": 726
        },
        {
          "kind": "+",
          "text": "      if n <= 0",
          "old": null,
          "new": 727
        },
        {
          "kind": "+",
          "text": "        after.call",
          "old": null,
          "new": 728
        },
        {
          "kind": "+",
          "text": "        return",
          "old": null,
          "new": 729
        },
        {
          "kind": "+",
          "text": "      end",
          "old": null,
          "new": 730
        }
      ],
      "after": [
        {
          "kind": "+",
          "text": "      @cycles += 1",
          "old": null,
          "new": 731
        },
        {
          "kind": "+",
          "text": "      remaining = n - 1",
          "old": null,
          "new": 732
        },
        {
          "kind": "+",
          "text": "      @resume = -> { tick(remaining, &after) }",
          "old": null,
          "new": 733
        },
        {
          "kind": "+",
          "text": "    end",
          "old": null,
          "new": 734
        },
        {
          "kind": "+",
          "text": "  end",
          "old": null,
          "new": 735
        },
        {
          "kind": "+",
          "text": "",
          "old": null,
          "new": 736
        },
        {
          "kind": "+",
          "text": "  class Field",
          "old": null,
          "new": 737
        },
        {
          "kind": "+",
          "text": "    # `run`'s non-fiber twin: drives every robot with `Robot#step!`",
          "old": null,
          "new": 738
        },
        {
          "kind": "+",
          "text": "    # instead of `Robot#cycle`, otherwise identical (same physics, same",
          "old": null,
          "new": 739
        },
        {
          "kind": "+",
          "text": "    # frame recording, same cycle/motion accounting). Kept as a separate",
          "old": null,
          "new": 740
        },
        {
          "kind": "+",
          "text": "    # method rather than a flag on `run` so the fiber path -- the CLI, and",
          "old": null,
          "new": 741
        },
        {
          "kind": "+",
          "text": "    # every other spec in this suite -- is untouched by this file. Used by",
          "old": null,
          "new": 742
        }
      ],
      "line_notes": {}
    },
    {
      "file": "site/wasi-shim.js",
      "note": "The page sends its chosen robots and match settings to the browser module. It gets standings and replay data back from the same battlefield introduced earlier.",
      "before": [
