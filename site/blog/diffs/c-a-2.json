  "excerpts": [
    {
      "file": "src/compiler/wasm_emitter.cr",
      "note": "The [[emitter|#word-emitter]] starts with the eight numbers every [[WebAssembly|#word-webassembly]] file needs: four to identify the file and four for its version. `minimal_module` joins them; later steps can add instructions after this valid beginning.",
      "before": [
        {
          "kind": "+",
          "text": "# The WebAssembly emitter. Every module starts with the same 8 bytes: a",
          "old": null,
          "new": 1
        },
        {
          "kind": "+",
          "text": "# 4-byte magic number spelling `\\0asm` and a 4-byte version. Nothing else",
          "old": null,
          "new": 2
        },
        {
          "kind": "+",
          "text": "# is required for a module to be valid — it just has no imports, functions",
          "old": null,
          "new": 3
        },
        {
          "kind": "+",
          "text": "# or exports.",
          "old": null,
          "new": 4
        },
        {
          "kind": "+",
          "text": "#",
          "old": null,
          "new": 5
        },
        {
          "kind": "+",
          "text": "# https://webassembly.github.io/spec/core/binary/modules.html#binary-module",
          "old": null,
          "new": 6
        },
        {
          "kind": "+",
          "text": "module CrystalRobots::Compiler",
          "old": null,
          "new": 7
        },
        {
          "kind": "+",
          "text": "  class WASM_Emitter",
          "old": null,
          "new": 8
        }
      ],
      "lines": [
        {
          "kind": "+",
          "text": "    MagicModuleHeader = Bytes[0x00, 'a'.ord, 's'.ord, 'm'.ord]",
          "old": null,
          "new": 9
        },
        {
          "kind": "+",
          "text": "    ModuleVersion     = Bytes[0x01, 0x00, 0x00, 0x00]",
          "old": null,
          "new": 10
        },
        {
          "kind": "+",
          "text": "",
          "old": null,
          "new": 11
        },
        {
          "kind": "+",
          "text": "    def self.minimal_module : Bytes",
          "old": null,
          "new": 12
        },
        {
          "kind": "+",
          "text": "      MagicModuleHeader + ModuleVersion",
          "old": null,
          "new": 13
        },
        {
          "kind": "+",
          "text": "    end",
          "old": null,
          "new": 14
        },
        {
          "kind": "+",
          "text": "  end",
          "old": null,
          "new": 15
        },
        {
          "kind": "+",
          "text": "end",
          "old": null,
          "new": 16
        }
      ],
      "after": [],
      "line_notes": {
        "MagicModuleHeader =": "`Bytes` is a list of numbers written straight to the file. The first four identify the file as WebAssembly."
      }
    },
    {
      "file": "spec/wasm_emitter_spec.cr",
      "note": "This [[spec|#word-test-spec]] checks the exact eight numbers written to the file. A byte is one small number, and checking each one helps catch a file that looks right in code but cannot be opened by a runner.",
      "before": [
        {
          "kind": "+",
          "text": "require \"./spec_helper\"",
          "old": null,
          "new": 1
        },
        {
          "kind": "+",
          "text": "require \"../src/compiler/wasm_emitter\"",
          "old": null,
          "new": 2
        },
        {
          "kind": "+",
          "text": "",
          "old": null,
          "new": 3
        }
      ],
      "lines": [
        {
          "kind": "+",
          "text": "alias W = CrystalRobots::Compiler::WASM_Emitter",
          "old": null,
          "new": 4
        },
        {
          "kind": "+",
          "text": "",
          "old": null,
          "new": 5
        },
        {
          "kind": "+",
          "text": "describe W do",
          "old": null,
          "new": 6
        },
        {
          "kind": "+",
          "text": "  it \"is the 8-byte magic header and version, nothing else\" do",
          "old": null,
          "new": 7
        },
        {
          "kind": "+",
          "text": "    W.minimal_module.should eq Bytes[0x00, 0x61, 0x73, 0x6D, 0x01, 0x00, 0x00, 0x00]",
          "old": null,
          "new": 8
        },
        {
          "kind": "+",
          "text": "  end",
          "old": null,
          "new": 9
        },
        {
          "kind": "+",
          "text": "end",
          "old": null,
          "new": 10
        }
      ],
      "after": [],
