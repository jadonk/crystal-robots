{
  "sha": "7c2560876d87f99703b76d1bf23a4f66f9240efe",
  "subject": "Phase W.5: pin the Pages workflow with Crystal's own YAML",
  "summary": "A test guards the publishing steps and Crystal version.",
  "files": [
    {
      "path": "spec/pages_workflow_spec.cr",
      "added": 49,
      "removed": 0,
      "role": "Checks that a piece of the project behaves as expected."
