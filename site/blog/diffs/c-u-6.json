      "file": "scripts/ci.sh",
      "note": "The [[CI|#word-ci]] script runs the specs and checks code formatting after building. With the Wasmer option, the compiled robot tests run too, so one command gives a clear result for a check-in.",
      "before": [
        {
          "kind": "+",
          "text": "    # bin/wasmer is found, so a partial install is cleared first.",
          "old": null,
          "new": 65
        },
        {
          "kind": "+",
          "text": "    rm -rf ./.wasmer",
          "old": null,
          "new": 66
        },
        {
          "kind": "+",
          "text": "    mkdir -p \"$WASMER_DIR/tmp\"",
          "old": null,
          "new": 67
        },
        {
          "kind": "+",
          "text": "    : > \"$WASMER_DIR/profile.sh\"",
          "old": null,
          "new": 68
        },
        {
          "kind": "+",
          "text": "    PROFILE=\"$WASMER_DIR/profile.sh\" TMPDIR=\"$WASMER_DIR/tmp\" WASMER_INSTALL_LOG=quiet \\",
          "old": null,
          "new": 69
        },
        {
          "kind": "+",
          "text": "      sh scripts/install_wasmer.sh v4.4.0",
          "old": null,
          "new": 70
        },
        {
          "kind": "+",
          "text": "    rm -rf \"$WASMER_DIR/tmp\"",
          "old": null,
          "new": 71
        },
        {
          "kind": "+",
          "text": "  fi",
          "old": null,
          "new": 72
        },
        {
          "kind": "+",
          "text": "  export PATH=\"$WASMER_DIR/bin:$PATH\"",
          "old": null,
          "new": 73
        },
        {
          "kind": "+",
          "text": "  \"$WASMER_DIR/bin/wasmer\" --version",
          "old": null,
          "new": 74
        },
        {
          "kind": "+",
          "text": "  spec_flags=\"-Dwasmer\"",
          "old": null,
          "new": 75
        },
        {
          "kind": "+",
          "text": "fi",
          "old": null,
          "new": 76
        }
      ],
