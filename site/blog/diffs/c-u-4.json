          "kind": "+",
          "text": "    # result gets observed at all), so there is no separate line for",
          "old": null,
          "new": 12
        },
        {
          "kind": "+",
          "text": "    # it: 14 lines cover the other 14 names in BUILTIN_NAMES.",
          "old": null,
          "new": 13
        },
