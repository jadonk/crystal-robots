    {
      "file": "spec/web/robot_api_spec.cr",
      "note": "Writing the table by hand has a risk: someone adds a builtin and forgets to describe it, or describes one that doesn't exist. This [[test|#word-test-spec]] closes that gap by comparing the table's names with the interpreter's own list. If they ever differ, the test fails.",
      "before": [
        {
          "kind": "+",
          "text": "require \"../spec_helper\"",
          "old": null,
          "new": 1
        },
        {
          "kind": "+",
          "text": "",
          "old": null,
          "new": 2
        },
        {
          "kind": "+",
          "text": "alias RobotAPI = CrystalRobots::Web::RobotAPI",
          "old": null,
          "new": 3
        },
        {
          "kind": "+",
          "text": "",
          "old": null,
          "new": 4
        },
        {
          "kind": "+",
          "text": "describe RobotAPI do",
          "old": null,
          "new": 5
        }
      ],
      "lines": [
        {
          "kind": "+",
          "text": "  it \"documents exactly the builtins the interpreter actually dispatches, no more and no less\" do",
          "old": null,
          "new": 6
