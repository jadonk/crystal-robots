          "kind": "+",
          "text": "",
          "old": null,
          "new": 9
        },
        {
          "kind": "+",
          "text": "  it \"every name in BUILTIN_NAMES is a real, callable builtin, not just a documentation entry\" do",
          "old": null,
          "new": 10
        },
