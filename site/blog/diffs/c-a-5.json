          "new": 54
        },
        {
          "kind": "+",
          "text": "",
          "old": null,
          "new": 55
        },
        {
          "kind": "+",
          "text": "    # An infix rule at level L reduces `V op V` only when the left operand",
          "old": null,
          "new": 56
        }
      ],
      "after": [
        {
          "kind": "+",
          "text": "    # is not preceded by an operator of level <= L (that operand belongs to",
          "old": null,
          "new": 57
        },
        {
          "kind": "+",
          "text": "    # the earlier operator, giving left associativity) and the right",
          "old": null,
          "new": 58
        },
        {
          "kind": "+",
          "text": "    # operand is not followed by an operator of a tighter level (that",
          "old": null,
          "new": 59
        },
        {
          "kind": "+",
          "text": "    # operand belongs to the tighter operator instead). See docs/PARSER.md",
          "old": null,
          "new": 60
        },
        {
          "kind": "+",
          "text": "    # section 2 for the full reasoning.",
          "old": null,
          "new": 61
        },
        {
          "kind": "+",
          "text": "    def self.infix(ops : String, higher : String) : Regex",
          "old": null,
          "new": 62
        },
        {
          "kind": "+",
          "text": "      ahead = higher.empty? ? \"\" : \"(?![#{higher}])\"",
          "old": null,
          "new": 63
        },
        {
          "kind": "+",
          "text": "      Regex.new(\"(?<![#{higher}#{ops}])#{V}[#{ops}]#{V}#{ahead}\")",
          "old": null,
          "new": 64
        },
        {
          "kind": "+",
          "text": "    end",
          "old": null,
          "new": 65
