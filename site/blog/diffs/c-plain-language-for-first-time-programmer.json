    {
      "file": "site/friendly-errors.js",
      "note": "The page turns compiler mistakes into short messages that keep names from the reader’s robot. A beginner can use the manual and fix a program without first learning the compiler’s internal labels.",
      "before": [
        {
          "kind": "+",
          "text": "  [/^(\\w+) takes (\\d+) arguments but is called with (\\d+)$/,",
          "old": null,
          "new": 19
        },
        {
          "kind": "+",
          "text": "    (_, name, n, got) => `${name} needs ${n} number${n === \"1\" ? \"\" : \"s\"}, but ${got} ${got === \"1\" ? \"was\" : \"were\"} given.`],",
          "old": null,
          "new": 20
        },
        {
          "kind": "+",
          "text": "  [/^undefined variable or function (\\w+)$/,",
          "old": null,
          "new": 21
        },
        {
          "kind": "+",
          "text": "    (_, name) => `The robot doesn't know the name ${name}. Check the spelling, or give it a value first.`],",
          "old": null,
          "new": 22
        },
        {
          "kind": "+",
          "text": "  [/^undefined variable (\\w+)$/,",
          "old": null,
          "new": 23
        },
        {
          "kind": "+",
          "text": "    (_, name) => `The robot doesn't know the name ${name}. Give it a value before using it.`],",
          "old": null,
          "new": 24
        },
        {
          "kind": "+",
          "text": "  [/^undefined function (\\w+)$/,",
          "old": null,
          "new": 25
        },
        {
          "kind": "+",
          "text": "    (_, name) => `There's no command named ${name}. Check the spelling, or see the manual's list of commands.`],",
          "old": null,
          "new": 26
        },
        {
          "kind": "+",
          "text": "  [/^call depth exceeded (\\d+) in (\\w+)$/,",
          "old": null,
          "new": 27
        },
        {
          "kind": "+",
          "text": "    (_, depth, name) => `${name} kept calling itself (more than ${depth} times deep), so the robot stopped and started over.`],",
          "old": null,
          "new": 28
        },
        {
          "kind": "+",
          "text": "  [/^runtime error: (.*)$/s,",
          "old": null,
          "new": 29
        },
        {
          "kind": "+",
          "text": "    (_, rest) => `Problem while running: ${friendlyError(rest)}`],",
          "old": null,
          "new": 30
        }
      ],
      "lines": [
        {
          "kind": "+",
          "text": "];",
          "old": null,
          "new": 31
        },
        {
          "kind": "+",
          "text": "",
          "old": null,
          "new": 32
        },
        {
          "kind": "+",
          "text": "export function friendlyError(message) {",
          "old": null,
          "new": 33
        },
        {
          "kind": "+",
          "text": "  const text = String(message || \"Something went wrong.\").trim();",
          "old": null,
          "new": 34
        },
        {
          "kind": "+",
          "text": "  for (const [pattern, explain] of MESSAGES) {",
          "old": null,
          "new": 35
        },
        {
          "kind": "+",
          "text": "    const match = text.match(pattern);",
          "old": null,
          "new": 36
        },
        {
          "kind": "+",
          "text": "    if (match) return explain(...match);",
          "old": null,
          "new": 37
        },
        {
          "kind": "+",
          "text": "  }",
          "old": null,
          "new": 38
        }
      ],
