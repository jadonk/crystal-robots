      "file": "src/compiler/wasm_resumable.cr",
      "note": "Each running call gets space to remember its position and unfinished values. This frame lets a compiled robot return after one cycle and continue later, even inside another function.",
      "before": [
        {
          "kind": "+",
          "text": "# The resumable encoder keeps every live value in linear memory. Each",
          "old": null,
          "new": 1
        },
        {
          "kind": "+",
          "text": "# activation occupies one fixed-size frame; the only native stack in step()",
          "old": null,
          "new": 2
        },
        {
          "kind": "+",
          "text": "# is emptied before a charged cycle returns to its host.",
          "old": null,
          "new": 3
        },
        {
          "kind": "+",
          "text": "# step() returns 0 for a pause, 1 when main completes, and 2 for a runtime",
          "old": null,
          "new": 4
        },
        {
          "kind": "+",
          "text": "# error. error_code is the one-based index of the function whose call exceeded",
          "old": null,
          "new": 5
        },
        {
          "kind": "+",
          "text": "# MAX_CALL_DEPTH (the only runtime error a checked, numeric WASM program has).",
          "old": null,
          "new": 6
        }
      ],
