      "file": "src/version.cr",
      "note": "The version reads a saved check-in identifier while the program is built. When someone reports a problem, this line identifies the exact build they used.",
      "before": [
        {
          "kind": " ",
          "text": "module CrystalRobots",
          "old": 1,
          "new": 1
        },
        {
          "kind": " ",
          "text": "  VERSION = \"0.0.1\"",
          "old": 2,
          "new": 2
        },
        {
          "kind": "+",
          "text": "",
          "old": null,
          "new": 3
        },
        {
          "kind": "+",
          "text": "  # The Fossil check-in this binary was built from. Fossil's versioned",
          "old": null,
          "new": 4
        },
        {
          "kind": "+",
          "text": "  # `manifest` setting (.fossil-settings/manifest holds \"u\") keeps",
          "old": null,
          "new": 5
        },
        {
          "kind": "+",
          "text": "  # `manifest.uuid` in every checkout and tarball; it is read once, at",
          "old": null,
          "new": 6
        },
        {
          "kind": "+",
          "text": "  # compile time. \"unknown\" when built from a plain source tree with",
          "old": null,
          "new": 7
        }
      ],
      "lines": [
        {
          "kind": "+",
          "text": "  # neither a checkout's generated file nor one written some other way.",
          "old": null,
          "new": 8
        },
        {
          "kind": "+",
          "text": "  CHECKIN = {{ (read_file?(\"#{__DIR__}/../manifest.uuid\") || \"unknown\").strip }}",
          "old": null,
          "new": 9
        },
        {
          "kind": "+",
          "text": "",
          "old": null,
          "new": 10
        },
        {
          "kind": "+",
          "text": "  # Short check-in for display, like Fossil's own timeline.",
          "old": null,
          "new": 11
        },
        {
          "kind": "+",
          "text": "  def self.checkin_short : String",
          "old": null,
          "new": 12
        },
        {
          "kind": "+",
          "text": "    CHECKIN == \"unknown\" ? CHECKIN : CHECKIN[0, 10]",
          "old": null,
          "new": 13
        },
        {
          "kind": "+",
          "text": "  end",
          "old": null,
          "new": 14
        },
        {
          "kind": "+",
          "text": "",
          "old": null,
          "new": 15
        }
      ],
      "after": [
        {
          "kind": "+",
          "text": "  # \"0.0.1 (check-in 724ff90d58)\": what --version and /version report, so",
          "old": null,
          "new": 16
        },
        {
          "kind": "+",
          "text": "  # a deploy can be compared against a specific check-in.",
          "old": null,
          "new": 17
        },
        {
          "kind": "+",
          "text": "  def self.version_line : String",
          "old": null,
          "new": 18
        },
        {
          "kind": "+",
          "text": "    \"crystal-robots #{VERSION} (check-in #{checkin_short})\"",
          "old": null,
          "new": 19
        },
        {
          "kind": "+",
          "text": "  end",
          "old": null,
          "new": 20
        },
        {
          "kind": " ",
          "text": "end",
          "old": 3,
          "new": 21
        }
      ],
      "line_notes": {
        "CHECKIN = {{": "Crystal reads the identifier while building the program and stores it in the result."
      }
