    {
      "file": "src/tournament/tournament.cr",
      "note": "The [[bracket|#word-bracket]] places the highest ranked robots apart and gives an empty slot, called a bye, to a top seed when needed. This carries the pool standings into the final rounds.",
      "before": [
        {
          "kind": "+",
          "text": "",
          "old": null,
          "new": 187
        },
        {
          "kind": "+",
          "text": "  # The standard seeded-bracket slot order (1 vs N, 2 vs N-1, ...",
          "old": null,
          "new": 188
        },
        {
          "kind": "+",
          "text": "  # without seed 2 ever meeting seed 1 before the final): for n=4,",
          "old": null,
          "new": 189
        },
        {
          "kind": "+",
          "text": "  # [1,4,2,3]; for n=8, [1,8,4,5,2,7,3,6].",
          "old": null,
          "new": 190
        },
        {
          "kind": "+",
          "text": "  private def self.seed_order(n : Int32) : Array(Int32)",
          "old": null,
          "new": 191
        },
        {
          "kind": "+",
          "text": "    return [1] if n <= 1",
          "old": null,
          "new": 192
        },
        {
          "kind": "+",
          "text": "    seed_order(n // 2).flat_map { |s| [s, n + 1 - s] }",
          "old": null,
          "new": 193
        },
        {
          "kind": "+",
          "text": "  end",
          "old": null,
          "new": 194
        },
        {
          "kind": "+",
          "text": "",
          "old": null,
          "new": 195
        },
        {
          "kind": "+",
          "text": "  # Seeds beyond `advancers.size` are byes (nil): with 3 advancers",
          "old": null,
          "new": 196
        },
        {
          "kind": "+",
          "text": "  # this gives \"2 vs 3, winner vs 1\" (seed 1 gets the bye, matching",
          "old": null,
          "new": 197
        },
        {
          "kind": "+",
          "text": "  # the wiki page's 5-or-fewer answer exactly); with 6 advancers in",
          "old": null,
          "new": 198
        }
      ],
      "lines": [
        {
          "kind": "+",
          "text": "  # an 8-slot bracket, seeds 1 and 2 get the byes.",
          "old": null,
          "new": 199
        },
        {
          "kind": "+",
          "text": "  private def self.bracket_slots(advancers : Array(String), size : Int32) : Array(String?)",
          "old": null,
          "new": 200
        },
        {
          "kind": "+",
          "text": "    seed_order(size).map { |s| s <= advancers.size ? advancers[s - 1] : nil }",
          "old": null,
          "new": 201
        },
        {
          "kind": "+",
          "text": "  end",
          "old": null,
          "new": 202
        },
        {
          "kind": "+",
          "text": "",
          "old": null,
          "new": 203
        },
        {
          "kind": "+",
          "text": "  # One bracket match: a bye (one slot empty) auto-advances the other",
          "old": null,
          "new": 204
        }
      ],
      "after": [
        {
          "kind": "+",
          "text": "  # entrant with no games played. Otherwise up to RETRY_LIMIT attempts",
          "old": null,
          "new": 205
        },
        {
          "kind": "+",
          "text": "  # total -- the same shared budget a pool pairing gets, not a fresh",
          "old": null,
          "new": 206
        },
        {
          "kind": "+",
          "text": "  # RETRY_LIMIT for each of up to 3 games -- stopping as soon as",
          "old": null,
          "new": 207
        },
        {
          "kind": "+",
          "text": "  # either entrant reaches 2 wins. A match still tied (including 0-0,",
          "old": null,
          "new": 208
        },
        {
          "kind": "+",
          "text": "  # every attempt a no-winner) after that budget is spent falls back",
          "old": null,
          "new": 209
        },
        {
          "kind": "+",
          "text": "  # to the first-listed, higher-seeded entrant: this needs no further",
          "old": null,
          "new": 210
        },
        {
          "kind": "+",
          "text": "  # information from a fight, the same way pool play's 0-0 does not,",
          "old": null,
          "new": 211
        },
        {
          "kind": "+",
          "text": "  # unlike the wiki page's very first idea (\"less damage wins\").",
          "old": null,
          "new": 212
        },
        {
          "kind": "+",
          "text": "  def self.play_match(a : String?, b : String?, cursor : Cursor, limit : Int32, fight : FightFn) : BracketMatch",
          "old": null,
          "new": 213
        },
        {
          "kind": "+",
          "text": "    log = [] of FightRecord",
          "old": null,
          "new": 214
        },
        {
          "kind": "+",
          "text": "    if a.nil? || b.nil?",
          "old": null,
          "new": 215
        },
        {
          "kind": "+",
          "text": "      winner = a || b || raise ArgumentError.new(\"bracket match with both slots empty\")",
          "old": null,
          "new": 216
        }
      ],
      "line_notes": {
        " : nil }": "`nil` means this bracket slot has no robot, so the paired robot gets a bye."
      }
    },
    {
      "file": "src/tournament/tournament.cr",
      "note": "A bracket match uses at most three fight attempts and stops when one robot has two wins. If those attempts leave a tie, the higher seed advances, so the tournament always finishes.",
      "before": [
        {
          "kind": "+",
          "text": "    seed_order(size).map { |s| s <= advancers.size ? advancers[s - 1] : nil }",
