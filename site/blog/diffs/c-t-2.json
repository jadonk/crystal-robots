      "lines": [
        {
          "kind": "+",
          "text": "  def self.play_match(a : String?, b : String?, cursor : Cursor, limit : Int32, fight : FightFn) : BracketMatch",
          "old": null,
          "new": 213
        },
        {
          "kind": "+",
          "text": "    log = [] of FightRecord",
          "old": null,
          "new": 214
        },
        {
          "kind": "+",
          "text": "    if a.nil? || b.nil?",
          "old": null,
          "new": 215
        },
        {
          "kind": "+",
          "text": "      winner = a || b || raise ArgumentError.new(\"bracket match with both slots empty\")",
          "old": null,
          "new": 216
        },
        {
          "kind": "+",
          "text": "      return BracketMatch.new([a, b], log, winner)",
          "old": null,
          "new": 217
        },
        {
          "kind": "+",
          "text": "    end",
          "old": null,
          "new": 218
        },
        {
          "kind": "+",
          "text": "    wins = Hash(String, Int32).new(0)",
          "old": null,
          "new": 219
        },
        {
          "kind": "+",
          "text": "    RETRY_LIMIT.times do",
          "old": null,
          "new": 220
        },
        {
          "kind": "+",
          "text": "      seed_used = cursor.next!",
          "old": null,
          "new": 221
        },
        {
          "kind": "+",
          "text": "      game_winner = fight.call([a, b], seed_used, limit)",
          "old": null,
          "new": 222
        },
        {
          "kind": "+",
          "text": "      log << FightRecord.new([a, b], seed_used, game_winner)",
          "old": null,
          "new": 223
        },
        {
          "kind": "+",
          "text": "      wins[game_winner] += 1 if game_winner",
          "old": null,
          "new": 224
        },
        {
          "kind": "+",
          "text": "      break if wins[a] >= 2 || wins[b] >= 2",
          "old": null,
          "new": 225
        },
        {
          "kind": "+",
          "text": "    end",
          "old": null,
          "new": 226
        },
        {
          "kind": "+",
          "text": "    winner = wins[a] > wins[b] ? a : (wins[b] > wins[a] ? b : a)",
          "old": null,
          "new": 227
        },
        {
          "kind": "+",
          "text": "    BracketMatch.new([a, b] of String?, log, winner)",
          "old": null,
          "new": 228
        },
        {
          "kind": "+",
          "text": "  end",
          "old": null,
          "new": 229
        }
      ],
