      "file": "spec/robots_spec.cr",
      "note": "This spec opens each robot page, finds its one code block and hands it to the parser and the checker. A broken example robot fails here, before anyone tries to fight it.",
      "before": [
        {
          "kind": "+",
          "text": "# code block, and that block must parse and pass the checker.",
          "old": null,
          "new": 4
        },
        {
          "kind": "+",
          "text": "FENCE = /^(`{3,})[^\\n]*\\n(.*?)\\n\\1[ \\t]*$/m",
          "old": null,
          "new": 5
        },
        {
          "kind": "+",
          "text": "",
          "old": null,
          "new": 6
        },
        {
          "kind": "+",
          "text": "describe \"robots/*.md\" do",
          "old": null,
          "new": 7
        },
        {
          "kind": "+",
          "text": "  files = Dir.glob(\"robots/*.md\").sort",
          "old": null,
          "new": 8
        },
        {
          "kind": "+",
          "text": "",
          "old": null,
          "new": 9
        },
        {
          "kind": "+",
          "text": "  it \"ships a handful of them\" do",
          "old": null,
          "new": 10
        },
        {
          "kind": "+",
          "text": "    files.size.should be >= 4",
          "old": null,
          "new": 11
        },
        {
          "kind": "+",
          "text": "  end",
          "old": null,
          "new": 12
        },
        {
          "kind": "+",
          "text": "",
          "old": null,
          "new": 13
        },
        {
          "kind": "+",
          "text": "  files.each do |file|",
          "old": null,
          "new": 14
        },
        {
          "kind": "+",
          "text": "    name = File.basename(file, \".md\")",
          "old": null,
          "new": 15
        }
      ],
      "lines": [
        {
          "kind": "+",
          "text": "    it \"#{name} has one code block that parses and checks clean\" do",
          "old": null,
          "new": 16
        },
        {
          "kind": "+",
          "text": "      blocks = File.read(file).scan(FENCE)",
          "old": null,
          "new": 17
