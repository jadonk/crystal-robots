          "kind": "+",
          "text": "    def fire_missile(i : Int32, degree : Int32, distance : Int32) : Bool",
          "old": null,
          "new": 177
        },
        {
          "kind": "+",
          "text": "      distance = MIS_RANGE if distance > MIS_RANGE",
          "old": null,
          "new": 178
        },
        {
          "kind": "+",
          "text": "      return true if distance < 0",
          "old": null,
          "new": 179
        },
        {
          "kind": "+",
          "text": "      degree = degree.abs",
          "old": null,
          "new": 180
        },
        {
          "kind": "+",
          "text": "      degree %= 360 if degree >= 360",
          "old": null,
          "new": 181
        },
        {
          "kind": "+",
          "text": "",
          "old": null,
          "new": 182
        },
        {
          "kind": "+",
          "text": "      r = @robots[i]",
          "old": null,
          "new": 183
        },
        {
          "kind": "+",
          "text": "      return false if r.reload > 0",
          "old": null,
          "new": 184
        },
        {
          "kind": "+",
          "text": "      slot = @missiles[i].find(&.status.avail?)",
          "old": null,
          "new": 185
        },
        {
          "kind": "+",
          "text": "      return false unless slot",
          "old": null,
          "new": 186
        },
        {
          "kind": "+",
          "text": "",
          "old": null,
          "new": 187
        },
        {
          "kind": "+",
          "text": "      r.reload = RELOAD",
          "old": null,
          "new": 188
        },
        {
          "kind": "+",
          "text": "      slot.status = MissileStatus::Flying",
          "old": null,
          "new": 189
        }
