        {
          "kind": " ",
          "text": "    end",
          "old": 90,
          "new": 90
        },
        {
          "kind": " ",
          "text": "",
          "old": 91,
          "new": 91
        },
        {
          "kind": " ",
          "text": "    # Grammar rules in priority order. Each pass applies the FIRST rule in",
          "old": 92,
          "new": 92
        },
        {
          "kind": " ",
          "text": "    # this list that matches anywhere, to every non-overlapping match.",
          "old": 93,
          "new": 93
        },
        {
          "kind": " ",
          "text": "    GRAMMAR = [",
          "old": 94,
          "new": 94
        },
        {
          "kind": " ",
          "text": "      # headers first: a def or main header must never be read as a call",
          "old": 95,
          "new": 95
        },
        {
          "kind": " ",
          "text": "      Rule.new(:main_head, /🏁⟮🐍⟯🔖⏎/, Type::MainHead),",
          "old": 96,
          "new": 96
        },
        {
          "kind": " ",
          "text": "      Rule.new(:global, /🌐⟮𝑥，#{V}⟯⏎/, Type::Statement),",
          "old": 97,
          "new": 97
        },
        {
          "kind": " ",
          "text": "      Rule.new(:def_head, /🔕𝑥(⟮(𝑥(，𝑥)*)?⟯)?⏎/, Type::DefHead),",
          "old": 98,
          "new": 98
        },
        {
          "kind": " ",
          "text": "      Rule.new(:literal, /[🔢🔚]/, Type::Expression),",
          "old": 99,
          "new": 99
        }
      ],
      "lines": [
        {
          "kind": " ",
          "text": "      Rule.new(:call0, /∉/, Type::Expression),",
          "old": 100,
          "new": 100
        },
        {
          "kind": " ",
          "text": "      Rule.new(:call, /𝑥⟮(#{V}(，#{V})*)?⟯/, Type::Expression),",
          "old": 101,
          "new": 101
        },
        {
          "kind": "+",
          "text": "      Rule.new(:call1, /∊⟮#{V}⟯/, Type::Expression),",
          "old": null,
          "new": 102
        },
        {
          "kind": "+",
          "text": "      Rule.new(:call2, /∋⟮#{V}，#{V}⟯/, Type::Expression),",
          "old": null,
          "new": 103
        },
        {
          "kind": " ",
          "text": "      Rule.new(:paren, /⟮#{V}⟯/, Type::Expression),",
          "old": 102,
          "new": 104
        },
        {
          "kind": " ",
          "text": "      Rule.new(:neg, /(?<![№𝑥😑⟯])⊖#{V}/, Type::Expression),",
          "old": 103,
          "new": 105
        },
        {
          "kind": " ",
          "text": "      Rule.new(:mul, infix(MULOPS, \"\"), Type::Expression),",
          "old": 104,
          "new": 106
        },
        {
          "kind": " ",
          "text": "      Rule.new(:add, infix(ADDOPS, MULOPS), Type::Expression),",
          "old": 105,
          "new": 107
        }
      ],
      "after": [
        {
          "kind": " ",
          "text": "      Rule.new(:cmp, infix(CMPOPS, MULOPS + ADDOPS), Type::Expression),",
          "old": 106,
          "new": 108
        },
        {
          "kind": " ",
          "text": "      Rule.new(:eq, infix(EQOPS, MULOPS + ADDOPS + CMPOPS), Type::Expression),",
          "old": 107,
          "new": 109
        },
        {
          "kind": " ",
          "text": "      Rule.new(:command1, /∊#{V}(?=[⏎⟯])/, Type::Expression),",
          "old": 108,
          "new": 110
        },
        {
          "kind": " ",
          "text": "      Rule.new(:command2, /∋#{V}，#{V}(?=[⏎⟯])/, Type::Expression),",
          "old": 109,
          "new": 111
        },
        {
          "kind": " ",
          "text": "      # assignment is right associative: only once the value is complete",
          "old": 110,
          "new": 112
        },
        {
          "kind": " ",
          "text": "      Rule.new(:assign, /𝑥＝#{V}(?=⏎)/, Type::Expression),",
