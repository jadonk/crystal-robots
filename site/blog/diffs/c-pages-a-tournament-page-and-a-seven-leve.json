  "excerpts": [
    {
      "file": "site/challenge/checks.js",
      "note": "Each challenge checks a real battle and gives a short reason for its result. The levels turn the tournament engine into a path from making a robot move to entering a match.",
      "before": [],
      "lines": [
        {
          "kind": "+",
          "text": "import { decodeFrames } from \"../battle-playback.js\";",
          "old": null,
          "new": 1
        },
        {
          "kind": "+",
          "text": "",
          "old": null,
          "new": 2
        },
        {
          "kind": "+",
          "text": "export function evaluateBattle(level, report) {",
          "old": null,
          "new": 3
        },
        {
          "kind": "+",
          "text": "  const { frames, missileSlots } = decodeFrames(report.frameBuffer);",
          "old": null,
          "new": 4
        },
        {
          "kind": "+",
          "text": "  const first = frames[0].robots[0], last = frames.at(-1).robots[0];",
          "old": null,
          "new": 5
        },
        {
          "kind": "+",
          "text": "  const distance = Math.hypot(last.x - first.x, last.y - first.y);",
          "old": null,
          "new": 6
        },
        {
          "kind": "+",
          "text": "  const fired = frames.some((frame) => frame.robots[0].fired || frame.missiles.slice(0, missileSlots).some((missile) => missile.present));",
          "old": null,
          "new": 7
        },
        {
          "kind": "+",
          "text": "  const targetDamage = report.robots[1]?.damage || 0;",
          "old": null,
          "new": 8
        }
      ],
      "after": [
        {
          "kind": "+",
          "text": "  const won = report.winner === \"Your robot\";",
          "old": null,
          "new": 9
        },
        {
          "kind": "+",
          "text": "  if (level === 1) return { pass: distance > 100, reason: `Your robot moved ${Math.round(distance)} m; the goal is more than 100 m.` };",
          "old": null,
          "new": 10
        },
        {
          "kind": "+",
          "text": "  if (level === 2) return { pass: fired, reason: fired ? \"Your robot fired a missile after looking for the target.\" : \"No missile appeared; scan for the target and fire when you find it.\" };",
          "old": null,
          "new": 11
        },
        {
          "kind": "+",
          "text": "  if (level === 3) return { pass: targetDamage > 0, reason: targetDamage > 0 ? `The target took ${targetDamage}% damage.` : \"The target took no damage; adjust your aim or range.\" };",
          "old": null,
          "new": 12
        },
        {
          "kind": "+",
          "text": "  if (level === 4) return { pass: won && targetDamage >= 100, reason: won && targetDamage >= 100 ? \"You destroyed the target before the cycle limit.\" : `The target finished with ${targetDamage}% damage; destroy it to pass.` };",
          "old": null,
          "new": 13
        },
        {
          "kind": "+",
          "text": "  return { pass: won, reason: won ? \"Your robot won this fight.\" : `This fight went to ${report.winner || \"a draw\"}.` };",
          "old": null,
          "new": 14
        },
        {
          "kind": "+",
          "text": "}",
          "old": null,
          "new": 15
        },
        {
          "kind": "+",
          "text": "export function evaluateSeries(wins, opponent) {",
          "old": null,
          "new": 16
        },
        {
          "kind": "+",
          "text": "  return { pass: wins >= 2, reason: `Your robot beat ${opponent} in ${wins} of 3 seeded fights; 2 wins are needed.` };",
          "old": null,
          "new": 17
        },
        {
          "kind": "+",
          "text": "}",
          "old": null,
          "new": 18
        },
        {
          "kind": "+",
          "text": "export function evaluateTournament(report) {",
          "old": null,
          "new": 19
        },
        {
          "kind": "+",
          "text": "  const reached = report.rounds?.some((round) => round.matches.some((match) => match.entrants.includes(\"Your robot\"))) || false;",
          "old": null,
          "new": 20
        }
      ],
      "line_notes": {}
    },
    {
